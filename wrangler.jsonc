{
  // kubeflare — a real Kubernetes cluster on a Cloudflare Container.
  //
  //   npm install && ./scripts/deploy.sh
  //
  // No account ID here on purpose: wrangler uses whichever account you are logged
  // into. If you belong to several, set CLOUDFLARE_ACCOUNT_ID in your environment.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kubeflare",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "observability": { "enabled": true },

  "vars": {
    // flannel's default vxlan backend cannot start here — the Cloudflare kernel
    // has no vxlan device. host-gw needs none. See docs/FINDINGS.md.
    "FLANNEL_BACKEND": "host-gw",
    // "nftables" or "iptables". Neither can program Services on the current
    // kernel; nftables just fails quietly instead of looping on errors.
    "KUBE_PROXY_MODE": "nftables",
    // Only needed if you wire up a Cloudflare Tunnel (docs/TUNNEL.md). It is
    // added to the apiserver certificate's SANs.
    "TUNNEL_HOSTNAME": "",
    // R2 bucket for durable cluster state (litestream). The bucket name is not
    // sensitive; the endpoint (it embeds your account id) and credentials are
    // Worker secrets — deploy.sh prints instructions.
    "R2_BUCKET": "kubeflare-state",
    // R2 bucket holding the file data behind the juicefs-r2 StorageClass. Must
    // exist and must be covered by the same R2 token as R2_BUCKET. Set it to ""
    // to leave R2-backed PersistentVolumes off; it is off regardless unless
    // durable state is enabled. Do not point it at R2_BUCKET — JuiceFS refuses
    // to initialise a volume whose bucket already has objects in it.
    "R2_BUCKET_JFS": "kubeflare-jfs",
    // R2-backed pull-through image cache: the separate kubeflare-registry
    // Worker (cloudflare/serverless-registry). containerd mirrors docker.io to
    // it, and always keeps the real upstream as a fallback, so a broken mirror
    // makes pulls slow rather than impossible. Set to "" to pull from Docker Hub
    // directly. The read-only credentials are Worker secrets.
    "REGISTRY_MIRROR_URL": "https://kubeflare-registry.the-loewenthal-corporation.workers.dev"
  },

  "containers": [
    {
      "class_name": "KubeFlare",
      "image": "./container/Dockerfile",
      // The build context defaults to the Dockerfile's directory, which cannot
      // see svcproxy/ — so it is the repo root, and COPY paths in the
      // Dockerfile are repo-relative.
      "image_build_context": ".",
      "max_instances": 1,
      // 2 vCPU / 8 GiB / 16 GB. Constraints: >= 3 GiB memory per vCPU, and
      // <= 2 GB disk per GiB memory. containerd needs the disk to unpack images.
      "instance_type": { "vcpu": 2, "memory_mib": 8192, "disk_mb": 16000 }

      // To SSH into the running container, add your own public key:
      // "authorized_keys": [{ "name": "me", "public_key": "ssh-ed25519 AAAA..." }]
      // then: npx wrangler containers ssh <INSTANCE_ID>
    }
  ],

  "durable_objects": {
    "bindings": [{ "name": "KUBEFLARE", "class_name": "KubeFlare" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["KubeFlare"] }]
}
